{
  "version": 1,
  "sdk_version": "0.22.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://fjajupvwitxipzatmmss.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "nest-pro-connector-mcp",
      "version": "0.1.0",
      "title": "Nest Pro Connector"
    },
    "tools": [
      {
        "name": "list_my_hot_leads",
        "title": "List my hot leads",
        "description": "List the signed-in user's hot leads (P1 companies with lead_score >= 80). Returns up to 25 top-scoring companies assigned to or created by the user.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 25,
              "description": "Max results (default 10)"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "search_companies",
        "title": "Search companies",
        "description": "Search companies visible to the signed-in user by partial name match. Returns id, name, score, priority tier and location for up to 20 matches.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "Partial company name"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_overdue_meetings",
        "title": "List overdue meetings",
        "description": "List meetings for the signed-in user that were scheduled in the past but have no completed_date set.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_my_notifications",
        "title": "List my notifications",
        "description": "List the signed-in user's notifications. Set unread_only to filter.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "unread_only": {
              "type": "boolean",
              "description": "Only unread notifications (default true)"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_company",
        "title": "Get company details",
        "description": "Fetch detailed information for a single company by id, including scoring, segment, and location fields the signed-in user can see.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "company_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "company_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_activity",
        "title": "Log an activity",
        "description": "Log a new outreach activity (call, email, meeting, note) against a company for the signed-in user.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "company_id": {
              "type": "string",
              "format": "uuid"
            },
            "activity_type": {
              "type": "string",
              "enum": [
                "call",
                "email",
                "meeting",
                "note",
                "task"
              ]
            },
            "notes": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "scheduled_date": {
              "type": "string",
              "format": "date-time",
              "description": "ISO timestamp for scheduled/planned activity"
            },
            "outcome": {
              "type": "string",
              "maxLength": 200
            }
          },
          "required": [
            "company_id",
            "activity_type",
            "notes"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
